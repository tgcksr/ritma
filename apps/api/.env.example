# SQLite for development. For PostgreSQL change `provider` in prisma/schema.prisma and use e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/ritma"
DATABASE_URL="file:./dev.db"

# Required in production: a long random string (min 32 chars)
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
SESSION_HOURS=12

PORT=3001
HOST=127.0.0.1

# Reminder job (mock SMS / e-mail providers)
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=60000
NOTIFY_LOCALE=tr
BUSINESS_NAME="Ritma"
BUSINESS_TIMEZONE="Europe/Istanbul"

# Initial admin account created by the seed script
ADMIN_EMAIL="admin@ritma.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Yönetici"

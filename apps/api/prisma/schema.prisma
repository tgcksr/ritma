// Prisma schema. Switching to PostgreSQL only requires changing `provider` and DATABASE_URL.
// Statuses/channels are stored as strings (validated by @ritma/shared) to stay portable across databases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  fullName     String
  phone        String        @unique
  email        String?
  notes        String?
  /// Accent/case-folded "name phone email" used for search.
  searchKey    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([searchKey])
  @@index([fullName])
}

model Service {
  id           String         @id @default(cuid())
  name         String
  durationMin  Int
  /// Price in minor currency units (kuruş / cents) to avoid floating point errors.
  priceCents   Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  staff        StaffService[]
  appointments Appointment[]
}

model Staff {
  id           String         @id @default(cuid())
  fullName     String
  phone        String?
  email        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  services     StaffService[]
  appointments Appointment[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Appointment {
  id            String            @id @default(cuid())
  customerId    String
  serviceId     String
  staffId       String?
  startAt       DateTime
  endAt         DateTime
  /// PENDING | CONFIRMED | COMPLETED | CANCELLED
  status        String            @default("PENDING")
  /// Service price captured at booking time, so later price changes don't rewrite history.
  priceCents    Int
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         Staff?            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  notifications NotificationLog[]

  @@index([startAt])
  @@index([staffId, startAt])
  @@index([customerId, startAt])
}

model NotificationLog {
  id                String      @id @default(cuid())
  appointmentId     String
  /// SMS | EMAIL
  channel           String
  /// REMINDER_24H | REMINDER_1H
  kind              String
  recipient         String
  subject           String?
  body              String
  providerMessageId String?
  sentAt            DateTime    @default(now())
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Guarantees each reminder is sent at most once per channel.
  @@unique([appointmentId, channel, kind])
  @@index([sentAt])
}
